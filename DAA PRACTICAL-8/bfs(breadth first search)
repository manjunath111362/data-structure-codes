
from collections import deque
def BFS(graph, src):
    visited = [False] * len(graph)
    q = deque()
    res = []
    visited[src] = True
    q.append(src)
    while q:
        curr = q.popleft()
        res.append(curr)
        for i in graph[curr]:
            if not visited[i]:
                visited[i] = True
                q.append(i)
    return res
# User input
n = int(input("Enter number of vertices: "))
graph = [[] for _ in range(n)]
for i in range(n):
    edges = list(map(int, input(f"Enter neighbours of vertex {i}: ").split()))
    graph[i] = edges
src = int(input("Enter starting vertex: "))
print("BFS Traversal:", BFS(graph, src))
