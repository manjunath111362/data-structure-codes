def matrix_chain(arr, n):
    dp = [[0] * n for _ in range(n)]
    for T in range(2, n):
        for i in range(n - T):
            j = i + T
            dp[i][j] = float('inf')
            for k in range(i + 1, j):
                cost = (dp[i][k] + dp[k][j] + arr[i] * arr[k] * arr[j])
                dp[i][j] = min(dp[i][j], cost)
    return dp[0][n - 1]
m = int(input("Enter number of matrices: "))
arr = []
for i in range(m + 1):
    x = int(input("Enter dimension: "))
    arr.append(x)
result = matrix_chain(arr, m + 1)
print("Minimum number of scalar multiplications =", result)
